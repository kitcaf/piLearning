      <mxGeometry x="390" y="212" width="440" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="pc" value="provider-composer：与内置厂商目录合成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1">
      <mxGeometry x="430" y="266" width="400" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="sn" value="snapshot（可用性快照，喂 UI 模型选择器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1">
      <mxGeometry x="390" y="334" width="440" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="streamSimple / getAuth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;fontColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sess" target="rt">
