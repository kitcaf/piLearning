    </mxCell>
    <mxCell id="rt" value="&lt;b&gt;ModelRuntime（实现 Models 接口）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
      <mxGeometry x="360" y="30" width="500" height="400" as="geometry"/>
    </mxCell>
    <mxCell id="rc" value="RuntimeCredentials（内存覆盖层）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1">
      <mxGeometry x="390" y="90" width="440" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="as" value="AuthStorage：auth.json（0600）+ 进程间文件锁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1">
      <mxGeometry x="430" y="144" width="400" height="42" as="geometry"/>
