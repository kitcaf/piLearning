<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="am1" value="AgentMessage[]&#10;（含自定义消息）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="40" y="80" width="180" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="am2" value="AgentMessage[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="340" y="80" width="180" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="msg" value="Message[]&#10;（纯 LLM 消息）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="640" y="80" width="180" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="llm" value="LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="900" y="80" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="transformContext()&#10;可选：压缩 / 裁剪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;fontColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="am1" target="am2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="convertToLlm()&#10;过滤 / 转换自定义消息" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;fontColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="am2" target="msg">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="msg" target="llm">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="note" value="只在发给 LLM 的前一刻投影；日志与状态里始终是完整的 AgentMessage[]" style="text;html=1;fontSize=13;fontColor=#666666;align=center;" vertex="1" parent="1">
      <mxGeometry x="200" y="180" width="640" height="30" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
