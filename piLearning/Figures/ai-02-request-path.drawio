<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="call" value="models.streamSimple(model, context, options)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="200" y="40" width="400" height="54" as="geometry"/>
    </mxCell>
    <mxCell id="lazy" value="lazyStream：立即同步返回事件流外壳&#10;以下步骤全部在背后异步执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="200" y="150" width="400" height="64" as="geometry"/>
    </mxCell>
    <mxCell id="s1" value="① 查注册表&#10;providers.get(model.provider)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="200" y="270" width="400" height="56" as="geometry"/>
    </mxCell>
    <mxCell id="s2" value="② 解析认证 getAuth(model)&#10;resolve 链：存储凭证 → 环境变量 → …&#10;OAuth 过期则在 modify 锁内刷新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="200" y="382" width="400" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="s3" value="③ 凭证织入请求&#10;options + apiKey / headers / baseUrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="200" y="518" width="400" height="56" as="geometry"/>
    </mxCell>
    <mxCell id="s4" value="④ provider.streamSimple(...)&#10;按 model.api 分发 → 协议适配器发出请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="200" y="630" width="400" height="64" as="geometry"/>
    </mxCell>
    <mxCell id="fail" value="任一步失败&#10;→ 流内 error 事件&#10;（不 throw）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="660" y="400" width="180" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="ev" value="事件逐个转发回外壳流，调用方无感知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="200" y="750" width="400" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="call" target="lazy">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lazy" target="s1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="s2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="ev">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="fail">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="fail">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
